# ============================================================================
# Personal Management Dashboard — configuration example
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Generate a secret with:  node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# ============================================================================

# --- Runtime ---------------------------------------------------------------
# development | production | test
NODE_ENV=development
# Local development port. 4000 is the project default; port 3000 on this
# machine belongs to a different, unrelated dev server.
PORT=4000
# Public origin of the app. Must be https:// in production (behind Caddy/Nginx).
APP_URL=http://localhost:4000
# silent | error | warn | info | debug
LOG_LEVEL=info

# --- Secrets (REQUIRED in production, never committed) --------------------
# Session signing secret, at least 32 characters.
SESSION_SECRET=
# 32 random bytes as hex (64 hex characters). Encrypts OneDrive tokens and MFA
# secrets at rest (AES-256-GCM). Rotating this invalidates stored integrations.
APP_ENCRYPTION_KEY=

# In development/test only: if the two values above are empty, the app generates
# and stores throwaway values in data/.dev-secrets.json (gitignored) and logs a
# warning. Production refuses to start without real values.

# --- Database --------------------------------------------------------------
# Path is relative to the project root. Must live on a persistent volume.
DATABASE_PATH=./data/app.db

# --- Localisation ----------------------------------------------------------
DEFAULT_TIMEZONE=Asia/Jerusalem
# Primary UI language. "he" = Hebrew, right-to-left (renders the whole app RTL).
# "en" = English, left-to-right (secondary language, selectable in the UI).
# A signed-in user's own language preference overrides this (Phase 1).
DEFAULT_LANGUAGE=he

# --- Email / SMTP (optional) ----------------------------------------------
# Leave SMTP_HOST empty to run without email: in-app notifications still work.
# If SMTP_HOST is set, SMTP_USER, SMTP_PASS and SMTP_FROM are required.
SMTP_HOST=
SMTP_PORT=587
# tls (implicit SSL, usually port 465) | starttls | auto
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Personal Dashboard

# --- Microsoft OneDrive / Microsoft Graph (optional) ---------------------
# Register an app in Microsoft Entra ID; redirect URI must match:
#   ${APP_URL}/api/v1/integrations/onedrive/callback
# Delegated permissions requested in v1: offline_access Files.Read (read only).
# Leave GRAPH_CLIENT_ID empty to run without OneDrive: the UI shows a clear
# "integration not configured" state instead of a fake connection.
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# common = personal + work accounts (a family Microsoft 365 account uses "common")
GRAPH_TENANT_ID=common
GRAPH_REDIRECT_PATH=/api/v1/integrations/onedrive/callback

# Dependencies
node_modules/

# Build output
.next/
out/
dist/
build/
*.tsbuildinfo

# Runtime data — database, cache, uploads, backups (NEVER committed)
data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key

# Local dev secrets auto-generated by src/lib/env.ts (matches any directory, including
# a throwaway DATABASE_PATH outside data/) and throwaway probe databases
.dev-secrets.json
.probe
.probe.db*
.probe-*

# Test + coverage output
coverage/
test-results/
playwright-report/
blob-report/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
npm-debug.log*

# Local helper scripts that may contain credentials (matches the habit in c:/src/myos)
push.bat
deploy-local.*
*.local.ps1
